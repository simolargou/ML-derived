{
  "name": "ml-derived",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.ts",
    "screenshot": "node scripts/capture-screenshot.mjs",
    "test:pages": "npm run build -- --base=/publication-check/ --outDir=dist-pages && playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
